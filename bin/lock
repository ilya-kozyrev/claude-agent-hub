#!/usr/bin/env python3
"""Agent lock board: lock list | take <resource> ... | release <resource> | rules ....

  lock list [--all]
  lock take <resource> --until <when> --why <reason> [--owner-name <name>] [--value <v>]
            [--repo <repo>] [--force]
  lock release <resource> [--repo <repo>] [--force]
  lock rules [show] [--json]                     resources and the commands each one guards, here
  lock rules init [--dir D] [--protected B ...]  start <repo>/.agent-hub/lock-rules.json (+ config.json defaults)
  lock rules add <resource> --about <text> [--match <regex> --action <text>] [--dir D]
  lock rules check "<command>" [--dir D] [--expect <resource> | --expect-none]
                                                 run the real hook against a board where every resource is held
                                                 by someone else: which lock would refuse the command

A resource is `main-merge` (built in) or a name from lock-rules.json (bin/lockrules.py): `take` refuses a name
that is not configured where you run it and lists the known ones; `release` accepts any name on the board.

<when>: 2026-09-25T18:00 (hub time zone if no offset), 18:00 (today), 2026-10-31 (end of day), +2h, +90m.
The holder is $CLAUDE_CODE_SESSION_ID; --owner-name defaults to this session's sidebar title.
A kind already held by another session's active lock is refused unless --force (a handover:
the previous holder is recorded in took_over_from). One lock per (kind, repo); --repo defaults to
AGENT_HUB_DEFAULT_REPO (env, the current repository's .agent-hub/config.json or the hub home's), else the name of
the git repository you run in (a worktree: its main repository, as the hook reads it); "*" (every repo) only with an
explicit --repo '*' or outside any git checkout. That name is the checkout directory's: a command that names another
repository (`gh pr merge -R owner/other-name`) is matched by the name it gives, so give --repo when they differ. `release` without --repo that finds nothing there releases this
session's only lock of the kind.
Board: $AGENT_BOARD_FILE, else <hub home>/board.md (`hub home` shows the hub home).
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import board  # noqa: E402
import hubcore as hc  # noqa: E402
import lockrules  # noqa: E402

DEFAULT_REPO = hc.default_repo() or board.DEFAULT_REPO


def session_title(sid: str) -> str | None:
    """Last custom-title of this session from its transcript, if any."""
    for path in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl")):
        title = None
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if '"custom-title"' in line:
                        try:
                            title = json.loads(line).get("customTitle") or title
                        except ValueError:
                            pass
        except OSError:
            continue
        if title:
            return title
    return None


def cmd_list(args) -> int:
    locks = board.load()
    at = board.now()
    shown = [r for r in locks if args.all or board.is_active(r, at)]
    if not shown:
        print("no active locks" if not args.all else "no locks")
        return 0
    for r in shown:
        state = "active" if board.is_active(r, at) else "EXPIRED"
        sid = r.get("session_id") or "-"
        extra = f" value={r['value']}" if r.get("value") else ""
        print(f"{r['kind']:15} {r.get('repo') or board.DEFAULT_REPO:10} {state:8} until {r['until']}  "
              f"{r.get('owner_name') or '?'} [{sid}]  — {r.get('why') or ''}{extra}")
    return 0


def cmd_take(args) -> int:
    known = lockrules.load(os.getcwd())
    try:
        on_board = {r["kind"] for r in board.load()}
    except board.BoardError:
        on_board = set()
    # A resource already on the board stays takeable (a handover of a lock taken where it was configured).
    if args.kind not in known["resources"] and args.kind not in on_board:
        print(f"unknown resource {args.kind!r} here ({os.getcwd()}). Known: {', '.join(known['resources'])}.\n"
              "Add it to the repository's .agent-hub/lock-rules.json (`lock rules add`, or the delamain:setup "
              "skill), or to the hub home's lock-rules.json.", file=sys.stderr)
        for w in known["warnings"]:
            print(w, file=sys.stderr)
        return 2
    sid = hc.session_id()
    if not sid and not args.force:
        print("No host session ID is set: the hook could not recognise you as the holder. "
              "Run from a Claude or Codex session, or pass --force to write an ownerless lock.", file=sys.stderr)
        return 2
    until = board.parse_time(args.until)
    if until <= board.now():
        print(f"--until {board.fmt(until)} is already in the past", file=sys.stderr)
        return 2
    name = args.owner_name or (session_title(sid) if sid else None) or (f"session {sid[:8]}" if sid else "?")
    repo = args.repo
    with board.Locked():
        locks = board.load()
        keep, prev = [], None
        for r in locks:
            if r["kind"] == args.kind and (r.get("repo") or board.DEFAULT_REPO) == repo:
                prev = r
            else:
                keep.append(r)
        if prev and board.is_active(prev) and prev.get("session_id") != sid and not args.force:
            print(f"refused: {args.kind} ({repo}) is held by {prev.get('owner_name')} "
                  f"[{prev.get('session_id') or '-'}] until {prev['until']}: {prev.get('why')}\n"
                  "Ask the holder (SendMessage), or take it over with --force if you are the successor.",
                  file=sys.stderr)
            return 1
        rec = {
            "kind": args.kind, "repo": repo, "owner_name": name, "session_id": sid,
            "until": board.fmt(until), "why": args.why, "taken_at": board.fmt(board.now()),
        }
        if args.value:
            rec["value"] = args.value
        if prev and board.is_active(prev) and prev.get("session_id") != sid:
            rec["took_over_from"] = f"{prev.get('owner_name')} [{prev.get('session_id') or '-'}]"
        keep.append(rec)
        board.write(keep)
    print(f"taken: {args.kind} ({repo}) by {name} [{sid or '-'}] until {rec['until']}")
    return 0


def cmd_release(args) -> int:
    sid = hc.session_id()
    explicit = args.repo is not None
    args.repo = args.repo or DEFAULT_REPO
    with board.Locked():
        locks = board.load()
        hit = [r for r in locks if r["kind"] == args.kind and (r.get("repo") or board.DEFAULT_REPO) == args.repo]
        if not hit and not explicit and sid:
            # The default repo depends on the working directory; a lock taken elsewhere is still found when this
            # session holds exactly one lock of that kind.
            own = [r for r in locks if r["kind"] == args.kind and r.get("session_id") == sid]
            if len(own) == 1:
                hit = own
                args.repo = own[0].get("repo") or board.DEFAULT_REPO
                print(f"note: no {args.kind} ({DEFAULT_REPO}) lock; releasing your only {args.kind} lock "
                      f"({args.repo})")
            elif len(own) > 1:
                names = ", ".join(f"{args.kind} ({r.get('repo') or board.DEFAULT_REPO})" for r in own)
                print(f"no {args.kind} ({DEFAULT_REPO}) lock; this session holds {names} — pass --repo; "
                      "nothing released", file=sys.stderr)
                return 1
        if not hit:
            print(f"no {args.kind} ({args.repo}) lock on the board")
            return 0
        r = hit[0]
        if r.get("session_id") != sid and board.is_active(r) and not args.force:
            print(f"refused: {args.kind} ({args.repo}) belongs to {r.get('owner_name')} "
                  f"[{r.get('session_id') or '-'}]; --force to drop someone else's lock", file=sys.stderr)
            return 1
        board.write([x for x in locks if x is not r])
    print(f"released: {args.kind} ({args.repo})")
    return 0


# ---------------------------------------------------------------- rules

def repo_root(raw: str | None) -> Path:
    """The working tree to configure: --dir, else the git top level of the working directory. A linked worktree
    with its own .agent-hub/ is configured itself, one without it — the main checkout: the same choice project_dir
    makes when reading, so a rule written here is the rule read here."""
    d = Path(raw or os.getcwd()).expanduser().resolve()
    res = subprocess.run(["git", "-C", str(d), "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                         env=hc.git_env())
    if res.returncode != 0:
        raise SystemExit(f"{d} is not inside a git repository (pass --dir)")
    top = Path(res.stdout.strip())
    if (top / ".git").is_file() and not (top / hc.CONFIG_DIRNAME).is_dir():
        return hc.main_checkout(top) or top
    return top


def repo_name(top: Path) -> str:
    """Repository name as the hook sees it: a worktree resolves to its main repository."""
    return hc.git_repo_name(top) or top.name


def rules_path(top: Path) -> Path:
    return top / hc.CONFIG_DIRNAME / "lock-rules.json"


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    hc.atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def cmd_rules_show(args) -> int:
    r = lockrules.load(os.getcwd())
    by = {k: [x["action"] for x in r["rules"] if k in x["kinds"]] for k in r["resources"]}
    if args.json:
        print(json.dumps({"files": r["files"], "protected_branches": r["protected_branches"],
                          "resources": [{"name": k, "about": v, "guards": by[k]} for k, v in r["resources"].items()],
                          "warnings": r["warnings"]}, ensure_ascii=False, indent=2))
        return 0
    print("files: " + (", ".join(r["files"]) or "none (built-in rules only)"))
    print("protected branches: " + ", ".join(r["protected_branches"]))
    for k, about in r["resources"].items():
        guards = "merge/push to the protected branches" if k == "main-merge" else ("; ".join(by[k]) or
                                                                                  "nothing (informational)")
        print(f"  {k:16} {about or '—'}\n  {'':16} guards: {guards}")
    for w in r["warnings"]:
        print(f"WARNING: {w}", file=sys.stderr)
    return 0


def cmd_rules_init(args) -> int:
    top = repo_root(args.dir)
    path = rules_path(top)
    if path.exists() or path.is_symlink():
        lockrules.read(str(path))  # raises on a broken file: say so rather than build on it
        print(f"{path} exists — left as it is")
    else:
        write_json(path, {"protected_branches": args.protected or ["main"], "resources": {}, "rules": []})
        print(f"wrote {path} (protected branches: {', '.join(args.protected or ['main'])}; no other resources yet)")
    cfg = top / hc.CONFIG_DIRNAME / "config.json"
    try:
        data = json.loads(cfg.read_text(encoding="utf-8")) if cfg.exists() else {}
    except ValueError as e:
        print(f"{cfg}: {e} — fix it by hand", file=sys.stderr)
        return 2
    if "AGENT_HUB_DEFAULT_REPO" in data:
        print(f"{cfg}: AGENT_HUB_DEFAULT_REPO={data['AGENT_HUB_DEFAULT_REPO']} — left as it is")
    else:
        data["AGENT_HUB_DEFAULT_REPO"] = repo_name(top)
        write_json(cfg, data)
        print(f"{cfg}: AGENT_HUB_DEFAULT_REPO={data['AGENT_HUB_DEFAULT_REPO']} (locks taken here guard this repo)")
    return 0


def cmd_rules_add(args) -> int:
    if not lockrules.valid_name(args.resource):
        print(f"bad resource name {args.resource!r}: lowercase letters, digits and hyphens", file=sys.stderr)
        return 2
    if args.resource in lockrules.BUILTIN:
        print(f"{args.resource} is built in: its commands are the merges and pushes to protected_branches",
              file=sys.stderr)
        return 2
    if args.action and len(args.action) != len(args.match):
        print("give one --action per --match (or none)", file=sys.stderr)
        return 2
    top = repo_root(args.dir)
    path = rules_path(top)
    if path.exists():
        lockrules.read(str(path))
        data = json.loads(path.read_text(encoding="utf-8"))
    else:
        data = {"protected_branches": ["main"], "resources": {}, "rules": []}
    if "resources" not in data:
        # a file without declarations (0.2.0 style): declare what its rules already use, so they stay valid
        data["resources"] = {k: "" for r in data.get("rules") or [] for k in r.get("kinds") or []
                             if k not in lockrules.BUILTIN}
    res = data["resources"]
    if args.resource not in res and not args.about:
        print(f"{args.resource} is new: say what it is with --about", file=sys.stderr)
        return 2
    if args.about:
        res[args.resource] = args.about
    rules = data.setdefault("rules", [])
    for i, m in enumerate(args.match):
        rule = {"match": m, "kinds": [args.resource], "action": args.action[i] if args.action else m}
        if not any(r.get("match") == m and args.resource in r.get("kinds", []) for r in rules):
            rules.append(rule)
    tmp = path.with_name(".lock-rules.check.json")
    write_json(tmp, data)
    try:
        lockrules.read(str(tmp))  # validate before replacing the real file
    except lockrules.RulesError as e:
        print(str(e).replace(str(tmp), str(path)), file=sys.stderr)
        return 2
    finally:
        tmp.unlink(missing_ok=True)
    write_json(path, data)
    print(f"{path}: {args.resource} — {res[args.resource]}; rules: {len(args.match)} added")
    return 0


def cmd_rules_check(args) -> int:
    """Run the plugin's own hook on `command` with a scratch board where every known resource is held by another
    session: the deny names the resource that guards the command; no deny = nothing guards it."""
    cwd = str(Path(args.dir).expanduser().resolve()) if args.dir else os.getcwd()
    known = lockrules.load(cwd)
    hook = Path(__file__).resolve().parent.parent / "hooks" / "board_locks.py"
    with tempfile.TemporaryDirectory() as tmp:
        until = board.fmt(board.now() + board.dt.timedelta(hours=1))
        recs = [{"kind": k, "repo": "*", "owner_name": "setup check", "session_id": "setup-check-holder",
                 "until": until, "why": "lock rules check"} for k in known["resources"]]
        env = dict(os.environ, AGENT_BOARD_FILE=os.path.join(tmp, "board.md"))
        saved = board.BOARD
        board.BOARD = Path(env["AGENT_BOARD_FILE"])
        try:
            board.write(recs)
        finally:
            board.BOARD = saved
        event = {"tool_name": "Bash", "tool_input": {"command": args.command}, "cwd": cwd,
                 "session_id": "setup-check-runner"}
        res = subprocess.run([sys.executable, str(hook)], input=json.dumps(event), capture_output=True, text=True,
                             env=env, cwd=cwd)
    out = {}
    if res.stdout.strip():
        try:
            out = json.loads(res.stdout)
        except ValueError:
            pass
    deny = (out.get("hookSpecificOutput") or {}).get("permissionDecisionReason") or ""
    m = re.search(r"another session's `([a-z0-9-]+)` lock", deny)
    got = m.group(1) if m else None
    action = deny.split("\n", 1)[0].removeprefix("Command refused by the board_locks hook: ").rstrip(".") if deny else ""
    print(f"guarded by {got}: {action}" if got else "not guarded: no lock would refuse it")
    if res.stderr.strip():
        print(res.stderr.strip(), file=sys.stderr)
    if args.expect:
        if got != args.expect:
            print(f"FAIL: expected {args.expect}, got {got or 'nothing'}", file=sys.stderr)
            return 1
    elif args.expect_none and got:
        print(f"FAIL: expected nothing, got {got}", file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="lock", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    pl = sub.add_parser("list")
    pl.add_argument("--all", action="store_true", help="include expired locks")
    pt = sub.add_parser("take")
    pt.add_argument("kind", metavar="resource")
    pt.add_argument("--until", required=True)
    pt.add_argument("--why", required=True)
    pt.add_argument("--owner-name")
    pt.add_argument("--value")
    pt.add_argument("--repo", default=DEFAULT_REPO)
    pt.add_argument("--force", action="store_true")
    pr = sub.add_parser("release")
    pr.add_argument("kind", metavar="resource")
    pr.add_argument("--repo", default=None, help="default: AGENT_HUB_DEFAULT_REPO, else this git repository, else *; when that finds nothing, "
                    "this session's only lock of the kind")
    pr.add_argument("--force", action="store_true")
    pu = sub.add_parser("rules", help="the resources and rules that apply here; init, add, check")
    rsub = pu.add_subparsers(dest="rcmd")
    rs = rsub.add_parser("show")
    rs.add_argument("--json", action="store_true")
    ri = rsub.add_parser("init")
    ri.add_argument("--dir", help="the repository (default: the one you are in)")
    ri.add_argument("--protected", nargs="+", metavar="BRANCH", help="protected branches (default: main)")
    ra = rsub.add_parser("add")
    ra.add_argument("resource")
    ra.add_argument("--about", help="what the resource is (required when it is new)")
    ra.add_argument("--match", action="append", default=[], help="Python regex of a command that touches it")
    ra.add_argument("--action", action="append", default=[], help="what that command does (one per --match)")
    ra.add_argument("--dir")
    rc = rsub.add_parser("check")
    rc.add_argument("command")
    rc.add_argument("--dir")
    g = rc.add_mutually_exclusive_group()
    g.add_argument("--expect", metavar="RESOURCE")
    g.add_argument("--expect-none", action="store_true")
    args = p.parse_args(argv)
    if args.cmd == "rules" and not args.rcmd:
        args.rcmd, args.json = "show", False
    try:
        if args.cmd == "rules":
            return {"show": cmd_rules_show, "init": cmd_rules_init, "add": cmd_rules_add,
                    "check": cmd_rules_check}[args.rcmd](args)
        return {"list": cmd_list, "take": cmd_take, "release": cmd_release}[args.cmd](args)
    except lockrules.RulesError as e:
        print(f"{e} — fix the file first", file=sys.stderr)
        return 2
    except board.BoardError as e:
        print(f"board {board.BOARD} is broken ({e}); fix the ```locks block by hand", file=sys.stderr)
        return 3
    except ValueError as e:
        print(f"bad time: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
