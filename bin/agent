#!/usr/bin/env python3
"""Headless Claude agents that outlive the hub: agent spawn | status | send | stop
(also callable as agent-spawn / agent-status / agent-send / agent-stop).

Long work (a merge steward, a release rehearsal, anything > 1 h) runs as a detached `claude -p`
session instead of a hub sub-agent: it survives the hub's handoff, and any hub can talk to it.

  agent spawn --role R --cwd DIR --model MODEL [--effort LEVEL] --brief FILE
              [--worktree [BRANCH]] [--stage S] [--tag T] [--title "…"] [--permission-mode MODE]
  agent status [R] [--stage S] [--all]
  agent send R "msg" [--stage S]
  agent stop R [--stage S]

Files: <hub home>/<stage>/agents/<R>/ — log.jsonl (stream-json of every run), stderr.log, meta.json,
brief.md (copy of the brief), inbox.md (messages while the agent runs).
spawn: `claude -p` with a fixed --session-id, --output-format stream-json --verbose and a permission mode
(default bypassPermissions: nobody is there to approve a tool call; $AGENT_HUB_PERMISSION_MODE or
--permission-mode changes it), in its own session and process group (setsid), stdin from /dev/null: it
survives the calling shell and the calling session. The agent gets HUB_TAG=<tag>, HUB_STAGE and this
plugin's bin/ first on PATH (the brief footer names jlog by its absolute path, since a shell may put an old
same-named tool ahead); it is recorded in `roles` (kind headless, pid).
Model: an alias (opus, sonnet, haiku, fable) or a full id claude-…. An alias follows the CLI: a current Claude Code
resolves it to the latest model of that family, an older one (before 2.1.285) to an older model, and spawn warns about
it. The id the run reports in its init event is recorded (meta resolved_model) and shown by status, the journal line
and agent-top. $AGENT_HUB_MODEL_MAP pins aliases to ids ("sonnet=claude-sonnet-x-y,opus=…") — an opt-in, since a pin
goes stale with the next model release.
Effort: --effort, else $AGENT_HUB_DEFAULT_EFFORT, else high; haiku gets no effort flag.
Background sub-agents: a `claude -p` run whose turn ended waits for its background sub-agents only up to the
CLI's ceiling (10 min, then they are killed); an agent's run waits until they finish
(CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0, or $AGENT_HUB_BG_WAIT_CEILING_MS milliseconds).
These settings (and CLAUDE_BIN, AGENT_INIT_TIMEOUT, AGENT_HUB_BG_WAIT_CEILING_MS) may also come from config.json
of the agent's repository (<repo>/.agent-hub/) or of the hub home; a brief-footer.md there is appended to the
footer of every brief.
--worktree: the agent works in a git worktree of BRANCH (default agent/<R>; created from the checked-out commit of
--cwd when it does not exist): an existing worktree of that branch is reused wherever it is, so a re-spawn continues
the work; otherwise <repo>/.worktrees/<BRANCH> of the main repository, with /.worktrees/ added to .git/info/exclude
(never untracked noise). status and stop name it; nothing removes it — `git worktree remove` once the branch is
merged. Two agents in one checkout overwrite each other's files: give each writer its own worktree.
status: alive or not, the model, age of the last log event, model turns (of the last run, with the total once the
agent was resumed), the last assistant text line.
send: alive → appended to inbox.md, journaled as "@<tag> msg" and kept as unread; process gone →
the session is resumed detached with `claude --resume <id> -p "msg"` in the same cwd, the unread
messages replayed first (an agent that ended its turn before reading its inbox loses nothing;
agent status flags them). spawn and resume succeed only once the run writes its init event
(120 s, $AGENT_INIT_TIMEOUT); a CLI that rejects its flags is killed and reported, and no role is recorded.
stop: SIGTERM to the process group (SIGKILL after 10 s), role retired.
CLI binary: $CLAUDE_BIN, else the newer of `claude` on PATH and the newest CLI bundled with Claude Desktop (macOS);
spawn prints which one it took.
Exit: 0 ok, 1 failure / unknown agent, 2 usage.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hubcore as hc  # noqa: E402

import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

# `roles` is a script without .py; load it as a module to reuse set_role/retire_role.
_loader = importlib.machinery.SourceFileLoader("roles_cli", os.path.join(os.path.dirname(os.path.realpath(__file__)), "roles"))
_spec = importlib.util.spec_from_loader("roles_cli", _loader)
roles_cli = importlib.util.module_from_spec(_spec)
_loader.exec_module(roles_cli)

ALIASES = hc.MODEL_ALIASES
EFFORTS = hc.EFFORTS
DEFAULT_PERMISSION_MODE = "bypassPermissions"


model_map = hc.model_map


STRIP_ENV = ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SSE_PORT")

FOOTER = """
---
You are "{role}" (journal tag `{tag}`), stage `{stage}`, a headless `claude -p` session with nobody on the
other end: questions asked in chat are read by no one. The brief above is your contract.
- Talk to the hub only through the journal: `{jlog} "…"` (your tag is already in $HUB_TAG; run it by this path:
  another `jlog` earlier on PATH writes to a journal the hub does not read). Write only on events: MERGED / STOP /
  DONE / BLOCKED / a question. One line = status word, path, one sentence. The full report goes to `{report}`.
- A question to the hub: `{jlog} "@hub QUESTION …"`, then end your turn with the word BLOCKED and the report
  path. The answer arrives as a new message in this same session (the hub runs `agent send {role} "…"`,
  which resumes the session).
- Messages that arrive while you work: `{inbox}` — read it after every major step and before finishing.
- In `claude -p` the end of your turn is the end of the process: do not wait in `run_in_background` or a
  Monitor. Run a long command in the foreground with the Bash `timeout` raised (up to 600000 ms).
- Commit unfinished work before long runs: an interrupted turn loses whatever is uncommitted.
"""


def footer(stage: str, cwd: Path, **fields) -> str:
    """The standard footer plus the first brief-footer.md of the config layers (stage, the agent's repository,
    hub home), with {role} {tag} {stage} {report} {inbox} {jlog} filled in."""
    fields["stage"] = stage
    fields["jlog"] = shlex.quote(str(hc.BIN / "jlog"))
    text = FOOTER.format(**fields)
    extra = hc.config_file("brief-footer.md", stage, cwd)
    if extra:
        add = extra.read_text(encoding="utf-8").strip("\n")
        for k, v in fields.items():
            add = add.replace("{" + k + "}", str(v))
        text += add + "\n"
    return text


def git(*argv, cwd: Path) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(cwd), *argv], capture_output=True, text=True, env=hc.git_env())


WORKTREES_DIR = ".worktrees"


def _worktrees(top: Path) -> dict:
    """{branch: path} of every worktree of the repository (the main checkout included)."""
    res = git("worktree", "list", "--porcelain", cwd=top)
    out, path = {}, None
    for line in res.stdout.splitlines():
        if line.startswith("worktree "):
            path = Path(line[len("worktree "):])
        elif line.startswith("branch refs/heads/") and path is not None:
            out[line[len("branch refs/heads/"):]] = path
    return out


def make_worktree(repo: Path, role: str, branch: str | None) -> tuple[Path, str, bool]:
    """(path, branch, created) of the agent's worktree: an existing worktree of the branch is reused wherever it is;
    otherwise <main repository>/.worktrees/<branch>, with .worktrees/ in .git/info/exclude so it never shows as
    untracked. A branch checked out in the main checkout is refused: that is not isolation."""
    res = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=repo)
    if res.returncode != 0:
        raise hc.UsageError(f"--worktree: {repo} is not inside a git repository")
    common = Path(res.stdout.strip())
    top = common.parent if common.name == ".git" else Path(git("rev-parse", "--show-toplevel", cwd=repo).stdout.strip())
    branch = branch or f"agent/{role}"
    if git("check-ref-format", "--branch", branch, cwd=top).returncode != 0:
        raise hc.UsageError(f"--worktree: {branch!r} is not a valid branch name")
    existing = _worktrees(top).get(branch)
    if existing is not None and not existing.is_dir():
        # a worktree directory deleted without `git worktree remove`: drop the stale entry, then create it afresh
        git("worktree", "prune", cwd=top)
        existing = _worktrees(top).get(branch)
        if existing is not None and not existing.is_dir():  # prune keeps a locked entry
            raise hc.Failure(f"--worktree: {branch} is registered at {existing}, which is gone, and the entry is "
                             f"locked — `git worktree unlock {existing}` (then `git worktree prune`), or pick another "
                             "branch")
    if existing is not None:
        if existing.resolve() == top.resolve():
            raise hc.UsageError(f"--worktree: {branch} is checked out in the main checkout {top} — pick another branch")
        return existing, branch, False
    if git("rev-parse", "--verify", "--quiet", "HEAD", cwd=top).returncode != 0:
        raise hc.Failure(f"--worktree: the repository {top} has no commits yet — make a first commit "
                         "(`git commit --allow-empty -m \"first commit\"`); a worktree needs a commit to start from")
    path = top / WORKTREES_DIR / branch
    if path.exists():
        raise hc.Failure(f"--worktree: {path} exists and is not a worktree of {branch} — remove it or pick another branch")
    exclude = common / "info" / "exclude"
    try:
        lines = exclude.read_text(encoding="utf-8").splitlines() if exclude.exists() else []
        if f"/{WORKTREES_DIR}/" not in lines:
            exclude.parent.mkdir(parents=True, exist_ok=True)
            with open(exclude, "a", encoding="utf-8") as fh:
                fh.write(("" if not lines or lines[-1] == "" else "\n") + f"/{WORKTREES_DIR}/\n")
    except OSError as e:
        print(f"note: could not add /{WORKTREES_DIR}/ to {exclude}: {e}", file=sys.stderr)
    exists = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=top).returncode == 0
    argv = ["worktree", "add", str(path), branch] if exists else ["worktree", "add", "-b", branch, str(path)]
    res = git(*argv, cwd=repo)
    if res.returncode != 0:
        raise hc.Failure(f"git worktree add: {res.stderr.strip() or res.stdout.strip()}")
    return path, branch, True


def worktree_note(meta: dict) -> str:
    wt = meta.get("worktree")
    if not wt:
        return ""
    return f"worktree {wt['path']} ({wt['branch']}) — `git worktree remove {wt['path']}` once the branch is merged"


def agent_dir(stage: str, role: str) -> Path:
    if not role or "/" in role or role.startswith("."):
        raise hc.UsageError(f"bad role name {role!r}")
    return hc.root() / hc.check_stage(stage) / "agents" / role


def claude_bin(cwd=None) -> str:
    """The CLI to start (hubcore.find_claude: $CLAUDE_BIN, else the newer of `claude` on PATH and Claude Desktop's)."""
    cli = hc.find_claude(cwd)
    if not cli:
        raise hc.Failure("claude not found on PATH (set $CLAUDE_BIN)")
    return cli.path


def load_meta(stage: str, role: str) -> dict:
    try:
        return json.loads((agent_dir(stage, role) / "meta.json").read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise hc.Failure(f"no agent {role!r} in stage {stage} ({agent_dir(stage, role)})") from None


def save_meta(stage: str, role: str, meta: dict) -> None:
    hc.atomic_write(agent_dir(stage, role) / "meta.json", json.dumps(meta, ensure_ascii=False, indent=1) + "\n")


def alive(meta: dict) -> bool:
    pid = meta.get("pid")
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    try:
        cmd = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    except OSError:
        return True
    return meta["session_id"] in cmd  # guards against a reused pid


def child_env(stage: str, tag: str) -> dict:
    env = {k: v for k, v in hc.child_env().items() if k not in STRIP_ENV}
    env.update({"HUB_TAG": tag, "HUB_STAGE": stage})
    return env


BG_WAIT_ENV = "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"


def bg_wait_ceiling(cwd=None) -> str:
    """Milliseconds a run whose turn ended waits for its background sub-agents before the CLI kills them.
    The CLI's default (10 min) cuts a background sub-agent of a headless agent short; 0 waits until it finishes."""
    raw = str(hc.setting("AGENT_HUB_BG_WAIT_CEILING_MS", cwd=cwd) or "0").strip()
    if not re.fullmatch(r"[0-9]+", raw):
        raise hc.UsageError("AGENT_HUB_BG_WAIT_CEILING_MS must be a whole number of milliseconds (0 = no ceiling)")
    return raw


def init_timeout(cwd=None) -> int:
    """Seconds to wait for a run's init event (it comes after MCP servers connect): AGENT_INIT_TIMEOUT or 120."""
    try:
        return int(hc.setting("AGENT_INIT_TIMEOUT", cwd=cwd) or 120)
    except ValueError:
        raise hc.UsageError("AGENT_INIT_TIMEOUT must be a whole number of seconds") from None


def wait_for_init(proc, log: Path, offset: int, session_id: str, stderr: Path, timeout_s: int = 120) -> dict:
    """Block until the run writes its init event for this session and return it; kill the run and fail otherwise."""
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        try:
            with open(log, "rb") as fh:
                fh.seek(offset)
                for raw in fh:
                    try:
                        ev = json.loads(raw)
                    except ValueError:
                        continue
                    if ev.get("type") == "system" and ev.get("subtype") == "init" and ev.get("session_id") == session_id:
                        return ev
        except FileNotFoundError:
            pass
        if proc.poll() is not None:
            break
        time.sleep(0.3)
    code = proc.poll()
    if code is None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    tail = stderr.read_text(encoding="utf-8", errors="replace")[-600:].strip() if stderr.exists() else ""
    why = f"exited with code {code}" if code is not None else f"sent no init event in {timeout_s} s, killed"
    raise hc.Failure(f"claude {why}; stderr: {tail or '—'}")


def launch(meta: dict, prompt: str, resume: bool) -> int:
    d = Path(meta["dir"])
    # Session flags first: the id stays at the head of `ps` output whatever the prompt size.
    argv = [claude_bin(meta["cwd"])]
    argv += ["--resume", meta["session_id"]] if resume else ["--session-id", meta["session_id"]]
    argv += ["--model", meta["model"]]
    if meta.get("effort"):
        argv += ["--effort", meta["effort"]]
    argv += ["--output-format", "stream-json", "--verbose",
             "--permission-mode", meta.get("permission_mode") or DEFAULT_PERMISSION_MODE]
    if not resume:
        argv += ["-n", meta["title"]]
    argv += ["-p", prompt]
    log = d / "log.jsonl"
    offset = log.stat().st_size if log.exists() else 0
    # The shell outlives claude by one command: `exit-note` journals EXIT when the run died or ended without a status
    # word, so the hub's jwait wakes on it (otherwise a run killed by an API error on turn 1 stays silent).
    # Same process group (setsid), so agent-stop still kills both; exit-note output goes to stderr.log, not the jsonl.
    note = '"$@"; c=$?; python3 "$0" exit-note "$AGENT_ROLE" --stage "$HUB_STAGE" --code "$c" >&2; exit $c'
    argv = ["/bin/sh", "-c", note, str(Path(__file__).resolve())] + argv
    env = child_env(meta["stage"], meta["tag"])
    env["AGENT_ROLE"] = meta["role"]
    env[BG_WAIT_ENV] = bg_wait_ceiling(meta["cwd"])
    with open(log, "ab") as out, open(d / "stderr.log", "ab") as err:
        proc = subprocess.Popen(argv, cwd=meta["cwd"], stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                                env=env, start_new_session=True, close_fds=True)
    init = wait_for_init(proc, log, offset, meta["session_id"], d / "stderr.log", init_timeout(meta["cwd"]))
    # the id the CLI resolved the alias to: an alias follows the installed CLI, so this is what actually runs
    model = init.get("model")
    if isinstance(model, str) and hc.MODEL_VALUE_RE.fullmatch(model):
        meta["resolved_model"] = model
    return proc.pid


def model_name(meta: dict) -> str:
    """The model of an agent: the id its run reported, else the one requested (`sonnet`, or a pinned id)."""
    return meta.get("resolved_model") or meta["model"]


def model_text(meta: dict) -> str:
    """model_name, plus what was asked for when the CLI resolved it to something else (an alias)."""
    got = meta.get("resolved_model")
    return f"{got} (asked for {meta['model']})" if got and got != meta["model"] else meta["model"]


def journal(stage: str, fallback_tag: str, text: str) -> str:
    """One journal line under the caller's tag (HUB_TAG, else the registry entry of the calling session), else
    `fallback_tag`."""
    return hc.journal_append(stage, hc.caller_tag(stage) or fallback_tag, text)


def cmd_spawn(a) -> int:
    stage = hc.check_stage(a.stage or hc.default_stage())
    cwd = Path(a.cwd).expanduser().resolve()
    brief = Path(a.brief).expanduser().resolve()
    if not cwd.is_dir():
        raise hc.UsageError(f"--cwd {cwd}: no such directory")
    # Settings come from the agent's repository (its .agent-hub/config.json), not from the caller's.
    mmap = model_map(cwd)
    problem = hc.model_problem(a.model, cwd)
    if problem:
        raise hc.UsageError(f"--model: {problem}")
    given, a.model = a.model, mmap.get(a.model, a.model)
    default_effort = hc.setting("AGENT_HUB_DEFAULT_EFFORT", cwd=cwd) or "high"
    if default_effort not in EFFORTS:
        raise hc.UsageError(f"AGENT_HUB_DEFAULT_EFFORT={default_effort!r}: one of {EFFORTS}")
    effort = None if "haiku" in a.model else (a.effort or default_effort)
    # AGENT_HUB_EFFORT_RULES: the model x effort policy shared with the delegation hook (bin/subagent_rules.py)
    import subagent_rules  # noqa: E402
    denied = subagent_rules.check_spawn(given, a.model, effort, cwd)
    if denied:
        raise hc.UsageError(denied)
    pmode = a.permission_mode or hc.setting("AGENT_HUB_PERMISSION_MODE", cwd=cwd) or DEFAULT_PERMISSION_MODE
    bg_wait_ceiling(cwd)  # a bad value fails here, before any directory or process exists
    if not brief.is_file():
        raise hc.UsageError(f"--brief {brief}: no such file")
    cli = hc.find_claude(cwd)
    if cli is None:
        raise hc.Failure("claude not found on PATH, and no CLI is bundled with Claude Desktop (set $CLAUDE_BIN)")
    print(f"CLI {cli.describe()}")
    old_cli = hc.cli_warning(cli)
    if old_cli:
        hc.warn(old_cli)
    own = hc.caller_tag(stage)
    if own and hc.tag_is(a.tag or a.role, own):
        # jwait drops the caller's own tag and its sub-tags: the agent's DONE would never wake the hub
        raise hc.UsageError(f"--tag {a.tag or a.role!r} is a sub-tag of your own tag {own!r}; jwait would never "
                            f"deliver its lines — use {own}-{a.role}")
    d = agent_dir(stage, a.role)
    if (d / "meta.json").exists():
        old = load_meta(stage, a.role)
        if alive(old):
            raise hc.Failure(f"agent {a.role} is already running (pid {old['pid']}); agent stop {a.role} or pick another name")
    wt = None
    if a.worktree is not None:
        path, branch, created = make_worktree(cwd, a.role, a.worktree or None)
        wt = {"path": str(path), "branch": branch}
        print(f"worktree {path} on {branch} ({'created' if created else 'reused'})")
        cwd = path
    if (d / "meta.json").exists():
        # a finished agent of the same name: keep its files, start a clean directory
        d.rename(d.with_name(f"{a.role}.{time.strftime('%Y%m%d-%H%M%S')}"))
    d.mkdir(parents=True)
    tag = a.tag or a.role
    shutil.copyfile(brief, d / "brief.md")
    (d / "inbox.md").write_text(f"# Inbox of agent {a.role}\n\n", encoding="utf-8")
    report = hc.work_dir(stage) / f"{tag.replace('/', '-')}-REPORT.md"
    meta = {"role": a.role, "tag": tag, "stage": stage, "session_id": str(uuid.uuid4()), "model": a.model,
            "effort": effort, "permission_mode": pmode, "cwd": str(cwd), "dir": str(d), "brief": str(brief),
            "title": a.title or f"agent {a.role} ({stage})", "report": str(report),
            "started_at": hc.now().isoformat(timespec="seconds"), "runs": []}
    if wt:
        meta["worktree"] = wt
    prompt = brief.read_text(encoding="utf-8") + footer(stage, cwd, role=a.role, tag=tag, report=report,
                                                       inbox=d / "inbox.md")
    save_meta(stage, a.role, meta)
    try:
        pid = launch(meta, prompt, resume=False)
    except hc.Failure:
        d.rename(d.with_name(f"{a.role}.failed-{time.strftime('%Y%m%d-%H%M%S')}"))
        raise
    meta["pid"] = pid
    meta["runs"].append({"pid": pid, "at": hc.now().isoformat(timespec="seconds"), "kind": "spawn"})
    save_meta(stage, a.role, meta)
    roles_cli.set_role(stage, a.role, meta["session_id"], "headless", tag=tag, title=meta["title"],
                       note=f"agent-spawn {a.model}", pid=pid, cwd=str(cwd), log=str(d / "log.jsonl"))
    got = meta.get("resolved_model")
    line = journal(stage, tag, f"started headless agent {a.role} ({model_name(meta)}{'/' + effort if effort else ''}"
                               f"{', asked for ' + a.model if got and got != a.model else ''}), "
                               f"session {meta['session_id']}, pid {pid}, brief {brief}"
                               + (f", worktree {wt['path']} ({wt['branch']})" if wt else ""))
    print(f"started {a.role}: pid {pid}, session {meta['session_id']}\nlog {d / 'log.jsonl'}\n{line}")
    return 0


def read_log(path: Path) -> dict:
    """What the log of every run of the agent says: model turns (all runs, and the last run's), the last assistant
    text, the last result, whether a run started after it."""
    turns, run_turns, last_text, results, last_type = set(), set(), "", [], ""
    started_after_result = False
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return {"turns": 0, "run_turns": 0, "last_text": "", "result": None, "events": 0, "running_after_result": False}
    n = 0
    with fh:
        for raw in fh:
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            n += 1
            t = ev.get("type")
            last_type = t
            if t == "system" and ev.get("subtype") == "init":
                started_after_result = True
                run_turns = set()  # a resumed session logs one init per run: count the last run's turns apart
            elif t == "assistant":
                msg = ev.get("message") or {}
                turns.add(msg.get("id") or n)
                run_turns.add(msg.get("id") or n)
                for block in msg.get("content") or []:
                    if block.get("type") == "text" and block.get("text", "").strip():
                        last_text = [ln for ln in block["text"].splitlines() if ln.strip()][-1].strip()
            elif t == "result":
                results.append(ev)
                started_after_result = False
    return {"turns": len(turns), "run_turns": len(run_turns), "last_text": last_text,
            "result": results[-1] if results else None, "events": n, "running_after_result": started_after_result,
            "last_type": last_type}


def turns_text(info: dict) -> str:
    """"31" for an agent with one run, "31 (total 60)" once a resumed run's turns differ from the total."""
    if info["run_turns"] != info["turns"]:
        return f"{info['run_turns']} (total {info['turns']})"
    return str(info["turns"])


def pending_unread(meta: dict) -> list:
    """Unread messages the agent's log does not show as handled: after the message was queued the
    agent neither touched inbox.md in a tool call nor ended a run with DONE."""
    unread = meta.get("inbox_unread") or []
    if not unread:
        return []
    log = Path(meta["dir"]) / "log.jsonl"
    try:
        data = log.read_bytes()
    except FileNotFoundError:
        return unread
    pending = []
    for u in unread:
        handled = False
        for raw in data[u.get("log_offset", 0):].splitlines():
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            if ev.get("type") == "assistant":
                for block in (ev.get("message") or {}).get("content") or []:
                    if block.get("type") == "tool_use" and "inbox.md" in json.dumps(block.get("input"), ensure_ascii=False):
                        handled = True
            elif ev.get("type") == "result" and re.search(r"\bDONE\b", str(ev.get("result") or "")):
                handled = True
            if handled:
                break
        if not handled:
            pending.append(u)
    return pending


def status_line(stage: str, role: str) -> str:
    meta = load_meta(stage, role)
    log = Path(meta["dir"]) / "log.jsonl"
    info = read_log(log)
    try:
        mtime = hc.dt.datetime.fromtimestamp(log.stat().st_mtime, hc.TZ)
    except FileNotFoundError:
        mtime = None
    live = alive(meta)
    registry = hc.roles_load(stage)["roles"].get(role)
    if live:
        state = f"ALIVE (pid {meta['pid']})"
    elif info["result"] and not info["running_after_result"]:
        r = info["result"]
        cost = f", ${r['total_cost_usd']:.2f}" if isinstance(r.get("total_cost_usd"), (int, float)) else ""
        state = f"finished ({r.get('subtype')}{', error' if r.get('is_error') else ''}{cost})"
    else:
        state = "no process, no result (died or killed)"
    if registry is None:
        state += ", role retired"
    unread = pending_unread(meta) if not live else []
    if unread:
        state += (f"; unread inbox messages {len(unread)} since {unread[0]['at'][11:16]} — "
                  f"agent send {role} [text] resumes with them")
    text = info["last_text"][:220] + ("…" if len(info["last_text"]) > 220 else "")
    wt = meta.get("worktree")
    return (f"{role} [{meta['tag']}] {model_text(meta)}: {state}; last event {hc.age(mtime)} ago; "
            f"turns {turns_text(info)}; last: {text or '—'}" + (f"; worktree {wt['path']} ({wt['branch']})" if wt else ""))


def cmd_status(a) -> int:
    stage = hc.check_stage(a.stage or hc.default_stage())
    if a.role:
        print(status_line(stage, a.role))
        return 0
    base = hc.root() / stage / "agents"
    names = sorted(p.parent.name for p in base.glob("*/meta.json")) if base.is_dir() else []
    live_roles = hc.roles_load(stage)["roles"]
    names = [n for n in names if n in live_roles] if not a.all else names
    if not names:
        print("no headless agents" + ("" if a.all else " (--all includes retired ones)"))
        return 0
    for n in names:
        print(status_line(stage, n))
    return 0


def cmd_send(a) -> int:
    stage = hc.check_stage(a.stage or hc.default_stage())
    msg = hc.one_line(" ".join(a.text))
    meta = load_meta(stage, a.role)
    if a.role not in hc.roles_load(stage)["roles"]:
        raise hc.Failure(f"agent {a.role} was stopped (role retired); start a new one with agent spawn")
    if not alive(meta):
        bg_wait_ceiling(meta["cwd"])  # the resume would refuse a bad setting: refuse before the message is queued
    t = hc.now()
    if msg:
        with open(Path(meta["dir"]) / "inbox.md", "a", encoding="utf-8") as fh:
            fh.write(f"- {t:%Y-%m-%d %H:%M} {msg}\n")
    if alive(meta):
        if not msg:
            raise hc.UsageError("the agent is alive — a message text is required")
        log = Path(meta["dir"]) / "log.jsonl"
        meta.setdefault("inbox_unread", []).append({"at": t.isoformat(timespec="seconds"), "msg": msg,
                                                    "log_offset": log.stat().st_size if log.exists() else 0})
        save_meta(stage, a.role, meta)
        line = journal(stage, "cli", f"@{meta['tag']} {msg}")
        print(f"agent alive (pid {meta['pid']}): queued in its inbox, read after its current step; if it ends its turn "
              f"unread, agent status shows it and the next agent send replays it\n{line}")
        return 0
    unread = pending_unread(meta)
    if not msg and not unread:
        raise hc.UsageError("empty message and no unread inbox messages")
    parts = []
    if unread:
        parts.append("Hub messages that arrived while you were working — your log shows you did not read them:\n"
                     + "\n".join(f"- {u['at'][11:16]} {u['msg']}" for u in unread))
    if msg:
        parts.append(msg)
    pid = launch(meta, "\n\n".join(parts) + "\n\n(A message from the hub. The rules for talking to the hub are at the end of "
                 "the brief above: journal, report, inbox.)",
                 resume=True)
    meta["inbox_unread"] = []
    meta["pid"] = pid
    meta["runs"].append({"pid": pid, "at": t.isoformat(timespec="seconds"), "kind": "resume"})
    save_meta(stage, a.role, meta)
    with hc.roles_lock(stage):
        data = hc.roles_load(stage)
        data["roles"][a.role]["pid"] = pid
        hc.roles_save(stage, data)
    line = journal(stage, "cli", f"@{meta['tag']} (session resumed, pid {pid}"
                                 + (f", unread replayed: {len(unread)}" if unread else "") + f") {msg}".rstrip())
    print(f"no process was running — session {meta['session_id']} resumed: pid {pid}\n{line}")
    return 0


def cmd_stop(a) -> int:
    stage = hc.check_stage(a.stage or hc.default_stage())
    meta = load_meta(stage, a.role)
    how = "no process was running"
    if alive(meta):
        pgid = meta["pid"]
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(20):
            if not alive(meta):
                break
            time.sleep(0.5)
        if alive(meta):
            try:
                os.killpg(pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            time.sleep(0.5)
            how = "SIGKILL"
        else:
            how = "SIGTERM"
        if alive(meta):
            raise hc.Failure(f"pid {pgid} is alive after SIGKILL")
    if a.role in hc.roles_load(stage)["roles"]:
        roles_cli.retire_role(stage, a.role, "agent-stop")
    print(f"{a.role}: stopped ({how}), role retired")
    if worktree_note(meta):
        print(worktree_note(meta))
    return 0




def status_seen(stage: str, tag: str, since: hc.dt.datetime) -> bool:
    """Did the agent journal a status word (its own tag) since `since`? The words are the hub's wake words
    (hubcore.status_pattern: MERGED, STOP, DONE, BLOCKED, QUESTION, … plus $AGENT_HUB_JWAIT_MATCH)."""
    status_re = re.compile(hc.status_pattern(exit_word=False))
    day = since.date()
    while day <= hc.now().date():
        path = hc.journal_path(stage, day)
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                m = hc.JOURNAL_LINE_RE.match(line)
                if not m or not hc.tag_is(m.group(2), tag) or not status_re.search(m.group(3)):
                    continue
                hh, mm = map(int, m.group(1).split(":"))
                if hc.dt.datetime.combine(day, hc.dt.time(hh, mm), tzinfo=hc.TZ) >= since.replace(second=0, microsecond=0):
                    return True
        day += hc.dt.timedelta(days=1)
    return False


def cmd_exit_note(a) -> int:
    """Called by the launch shell after claude exits: journal EXIT unless the run ended cleanly with a status word."""
    stage = hc.check_stage(a.stage or hc.default_stage())
    meta = load_meta(stage, a.role)
    info = read_log(Path(meta["dir"]) / "log.jsonl")
    r = info["result"] or {}
    runs = meta.get("runs") or []
    since = hc.dt.datetime.fromisoformat(runs[-1]["at"]) if runs else hc.now() - hc.dt.timedelta(days=1)
    clean = a.code == 0 and r and not r.get("is_error") and r.get("subtype") == "success"
    if clean and status_seen(stage, meta["tag"], since):
        return 0
    why = "no status word in the journal" if clean else (f"{r.get('subtype')}, error" if r.get("is_error") else
                                                          (r.get("subtype") or "no result — died or killed"))
    last = (info["last_text"] or "").strip().splitlines()
    print(hc.journal_append(stage, meta["tag"], f"EXIT {a.role}: {why}; code {a.code}, turns {turns_text(info)}"
                            f"{'; last: ' + last[-1][:160] if last else ''} — agent status {a.role}"))
    return 0


def main(argv: list) -> int:
    prog = os.path.basename(sys.argv[0])
    sub_from_name = {"agent-spawn": "spawn", "agent-status": "status", "agent-send": "send", "agent-stop": "stop"}
    if prog in sub_from_name:
        argv = [sub_from_name[prog]] + argv
    p = argparse.ArgumentParser(prog="agent", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("spawn", help="start a headless agent")
    s.add_argument("--stage")
    s.add_argument("--role", required=True)
    s.add_argument("--cwd", required=True)
    s.add_argument("--model", required=True, help="opus | sonnet | haiku | fable (passed to the CLI, which resolves them to its "
                   "latest models; $AGENT_HUB_MODEL_MAP pins them to ids instead) or a full id claude-…")
    s.add_argument("--effort", choices=EFFORTS, help="default: $AGENT_HUB_DEFAULT_EFFORT or high; ignored for haiku")
    s.add_argument("--permission-mode", help=f"default: $AGENT_HUB_PERMISSION_MODE or {DEFAULT_PERMISSION_MODE}")
    s.add_argument("--brief", required=True)
    s.add_argument("--worktree", nargs="?", const="", default=None, metavar="BRANCH",
                   help="run in a worktree of BRANCH (default agent/<role>): the existing one, else <repo>/.worktrees/<BRANCH>")
    s.add_argument("--tag")
    s.add_argument("--title")
    st = sub.add_parser("status", help="alive or not, model, last event age, turns")
    st.add_argument("role", nargs="?")
    st.add_argument("--stage")
    st.add_argument("--all", action="store_true")
    se = sub.add_parser("send", help="message an agent (alive → inbox, gone → resume)")
    se.add_argument("role")
    se.add_argument("text", nargs="*", help="text; without text, resume with the unread inbox messages")
    se.add_argument("--stage")
    sp = sub.add_parser("stop", help="stop the agent and retire its role")
    sp.add_argument("role")
    sp.add_argument("--stage")
    en = sub.add_parser("exit-note", help="(internal) journal an EXIT line after the agent process exits")
    en.add_argument("role")
    en.add_argument("--stage")
    en.add_argument("--code", type=int, default=0)
    a = p.parse_args(argv)
    return {"spawn": cmd_spawn, "status": cmd_status, "send": cmd_send, "stop": cmd_stop,
            "exit-note": cmd_exit_note}[a.cmd](a)


if __name__ == "__main__":
    raise SystemExit(hc.run_main(main, sys.argv[1:]))
